# --- Database (required) ----------------------------------------------------
# Postgres connection string. On Vercel + Neon, set DATABASE_URL to the POOLED
# connection string (used at runtime) and DIRECT_URL to the DIRECT connection
# string (used by `prisma migrate`).
DATABASE_URL="postgresql://user:password@host:5432/cipherlink?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/cipherlink?sslmode=require"

# --- Rate limiting (required in production) ---------------------------------
# Sign up at https://upstash.com -> create a Redis database -> copy these
# from the "REST API" section. Without these, rate limiting is in-memory
# only and resets on every serverless invocation.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Origin lock (required in production) -----------------------------------
# Public origin where the app is deployed. The POST /api/secrets endpoint
# rejects requests whose Origin header doesn't match. Leave unset locally
# to allow same-origin without the check.
APP_ORIGIN="https://your-app.vercel.app"

# --- Sweeper cron (required in production) ----------------------------------
# Random secret used by Vercel Cron to call /api/sweep. Generate with:
#   openssl rand -base64 32
CRON_SECRET=""
